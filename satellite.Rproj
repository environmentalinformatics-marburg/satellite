Version: 1.0
ProjectId: 6eb5b5b6-bb0c-4b4e-bc3d-24c3295a676b

RestoreWorkspace: Default
SaveWorkspace: Default
AlwaysSaveHistory: Default

EnableCodeIndexing: Yes
UseSpacesForTab: Yes
NumSpacesForTab: 2
Encoding: UTF-8

RnwWeave: Sweave
LaTeX: pdfLaTeX

BuildType: Package
PackageInstallArgs: --no-multiarch --with-keep.source
PackageBuildArgs: --resave-data=best
PackageCheckArgs: --as-cran --run-donttest --no-manual
PackageRoxygenize: rd,collate,namespace
